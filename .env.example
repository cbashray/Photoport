# PhotoPort client_id and client_secret are loaded from credentials.json
# downloaded from Google Cloud Console. Do NOT commit that file.

# Path to Google OAuth credentials.json (Desktop Application type)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Optional: override temp directory for extracted files
# PHOTOPORT_TEMP_DIR=C:\Users\YourName\AppData\Local\Temp\PhotoPort

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
PHOTOPORT_LOG_LEVEL=INFO

# Optional: max concurrent uploads (1-3 recommended)
PHOTOPORT_MAX_CONCURRENT=1

# Optional: max retries per file
PHOTOPORT_MAX_RETRIES=5
